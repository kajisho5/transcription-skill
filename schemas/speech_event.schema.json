{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kajisho5/transcription-skill/schemas/speech_event.schema.json",
  "title": "SpeechEvent",
  "description": "transcription-skill/speech-event/0.1. An event-compatible candidate derived from Transcript segments. It mirrors the shape of a timeline event (type/start/end/source/confidence/metadata) so an adapter in a consumer can lift it, without this skill importing the consumer's model.",
  "type": "object",
  "required": ["schema", "type", "id", "start", "end", "asset_id", "transcript_id", "transcript_segment_ids", "source", "confidence", "metadata"],
  "properties": {
    "schema": {"const": "transcription-skill/speech-event/0.1"},
    "type": {"const": "SpeechEvent"},
    "id": {"type": "string"},
    "start": {"type": "number", "minimum": 0},
    "end": {"type": "number", "exclusiveMinimum": 0},
    "asset_id": {"type": "string"},
    "transcript_id": {"type": "string"},
    "transcript_segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source": {"type": "string", "description": "transcription-skill/<engine>@<engine_version>"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "metadata": {"type": "object", "properties": {"language": {"type": "string"}, "segment_texts": {"type": "array", "items": {"type": "string"}}, "merge_gap": {"type": "number"}}}
  }
}
